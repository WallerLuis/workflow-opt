{
  "permissions": {
    "deny": [
      "Edit(vault/**)",
      "Edit(//Users/luis/luis_obsidian_vault/**)",
      "Read(vault/.obsidian/**)",
      "Read(vault/.trash/**)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(readlink:*)",
      "Bash(./.claude/skills/verify-repo/check.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-vault-writes.sh"
          }
        ]
      }
    ]
  }
}
